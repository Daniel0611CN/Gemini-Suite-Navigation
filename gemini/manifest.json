{
"manifest_version": 3,
"name": "Gemini Suite Navigation",
"version": "1.2.0",
  "default_locale": "en",
  "description": "Local conversation navigation, organization, export, and backup tools for Gemini and AI Studio.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://gemini.google.com/*",
    "https://aistudio.google.com/*",
    "https://notebooklm.google.com/*"
  ],
  "background": {
    "service_worker": "src/background/background.js"
  },
  "options_ui": {
    "page": "src/ui/pages/options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-sidebar": {
      "suggested_key": {
        "default": "Alt+Shift+G"
      },
      "description": "Toggle the Gemini Suite Navigation sidebar"
    },
    "focus-search": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Focus Gemini Suite Navigation search"
    }
  },

  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/app/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "src/content/common/selectors.js",
        "src/content/common/organization.js",
        "src/content/common/compatibility.js",
        "src/content/common/content.js",
        "src/content/gemini/content_gemini.js"
      ],
      "css": [
        "src/ui/styles/themes.css",
        "src/ui/styles/sidebar.css",
        "src/ui/styles/buttons.css",
        "src/ui/styles/folder-enhancement.css",
        "src/ui/styles/styles.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://aistudio.google.com/*"
      ],
      "js": [
        "src/content/common/selectors.js",
        "src/content/common/organization.js",
        "src/content/common/compatibility.js",
        "src/content/common/content.js",
        "src/content/aistudio/content_aistudio.js"
      ],
      "css": [
        "src/ui/styles/themes.css",
        "src/ui/styles/sidebar.css",
        "src/ui/styles/buttons.css",
        "src/ui/styles/folder-enhancement.css",
        "src/ui/styles/styles.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://notebooklm.google.com/*"
      ],
      "js": [
        "src/content/common/selectors.js",
        "src/content/common/organization.js",
        "src/content/common/compatibility.js",
        "src/content/notebooklm/content_notebooklm.js"
      ],
      "css": [
        "src/ui/styles/themes.css",
        "src/ui/styles/sidebar.css",
        "src/ui/styles/styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
      {
          "resources": ["assets/lib/fonts/*"],
          "matches": ["https://gemini.google.com/*", "https://aistudio.google.com/*"]
      }
  ],
  "icons": {
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}
