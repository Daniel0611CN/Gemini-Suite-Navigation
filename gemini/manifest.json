{
"update_url": "https://clients2.google.com/service/update2/crx",

  "manifest_version": 3,
  "name": "Gemini Suite Navigation",
  "version": "1.0",
  "default_locale": "en",
  "description": "",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "src/background/background.js"
  },
  
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/app/*",
        "https://gemini.google.com/*",
        "https://aistudio.google.com/*"
      ],
      "js": [
        "src/content/common/content.js",
        "assets/lib/katex.min.js",
        "src/content/common/math_processor.js",
        "assets/lib/pdfmake.min.js",
        "assets/lib/vfs_fonts.js",
        "assets/lib/html-to-pdfmake.min.js",
        "src/content/gemini/content_gemini.js"
      ],
      "css": [
        "src/ui/styles/main.css",
        "assets/lib/katex.min.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
      {
          "resources": ["assets/lib/fonts/*"],
          "matches": ["https://gemini.google.com/*", "https://aistudio.google.com/*"]
      }
  ],
  "icons": {
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}
